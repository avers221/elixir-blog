<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section class="blog-intro">
    <p class="eyebrow">An independent journal</p>
    <h1 class="blog-intro-title">Stories worth<br class="sm:hidden" /> slowing down for.</h1>
    <p class="blog-intro-copy">
      Notes on building, learning, and the small details that make a life.
    </p>
    <.link :if={@current_scope} href={~p"/posts/new"} class="text-link mt-5 inline-flex">
      <.icon name="hero-plus" class="size-4" /> Write a story
    </.link>
  </section>

  <section aria-labelledby="latest-stories" class="story-list-section">
    <div class="section-heading">
      <h2 id="latest-stories">Latest stories</h2>
      <span class="section-count">{length(@posts)} {if length(@posts) == 1,
        do: "story",
        else: "stories"}</span>
    </div>

    <%= if Enum.empty?(@posts) do %>
      <div class="empty-state">
        <h3>No stories yet</h3>
        <p>The first story is waiting to be written.</p>
        <.link :if={@current_scope} href={~p"/posts/new"} class="text-link mt-4">
          Write the first one <span aria-hidden="true">→</span>
        </.link>
      </div>
    <% else %>
      <div id="posts" class="story-list">
        <article :for={post <- @posts} id={"post-#{post.id}"} class="story-teaser">
          <div class="story-meta">
            <span>{if post.user, do: post.user.email, else: "Guest author"}</span>
            <span class="meta-dot" aria-hidden="true">·</span>
            <time datetime={DateTime.to_iso8601(post.inserted_at)}>
              {Calendar.strftime(post.inserted_at, "%B %d, %Y")}
            </time>
            <span class="meta-dot" aria-hidden="true">·</span>
            <span>{reading_time(post.body)} min read</span>
          </div>

          <h3 class="story-title">
            <.link navigate={~p"/posts/#{post}"}>{post.title}</.link>
          </h3>

          <p class="story-excerpt">{body_preview(post.body)}</p>

          <div class="story-bottom">
            <.link navigate={~p"/posts/#{post}"} class="text-link">
              Read story <span aria-hidden="true">→</span>
            </.link>
            <div :if={Posts.can_manage_post?(@current_scope, post)} class="story-actions">
              <.link navigate={~p"/posts/#{post}/edit"}>Edit</.link>
              <.link
                href={~p"/posts/#{post}"}
                method="delete"
                data-confirm="Delete this story?"
              >
                Delete
              </.link>
            </div>
          </div>
        </article>
      </div>
    <% end %>
  </section>
</Layouts.app>
