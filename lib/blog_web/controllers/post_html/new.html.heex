<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section class="form-page">
    <.link href={~p"/"} class="text-link"><span aria-hidden="true">←</span> All stories</.link>
    <p class="eyebrow mt-8">Share something thoughtful</p>
    <h1 class="form-page-title">Write a story</h1>
    <p class="form-page-copy">Take your time. Your words deserve a little space.</p>
    <div class="form-panel mt-8">
      <.post_form form={@form} action={~p"/posts"} return_to={~p"/"} />
    </div>
  </section>
</Layouts.app>
