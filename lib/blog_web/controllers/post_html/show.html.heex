<Layouts.app flash={@flash} current_scope={@current_scope}>
  <article class="article-page">
    <nav aria-label="Breadcrumb" class="article-back">
      <.link navigate={~p"/"} class="text-link">
        <span aria-hidden="true">←</span> All stories
      </.link>
    </nav>

    <header class="article-header">
      <p class="eyebrow">
        A story by {if @post.user, do: @post.user.email, else: "Guest author"}
      </p>
      <h1 class="article-title">{@post.title}</h1>
      <div class="story-meta article-meta">
        <time datetime={DateTime.to_iso8601(@post.inserted_at)}>
          {Calendar.strftime(@post.inserted_at, "%B %d, %Y")}
        </time>
        <span class="meta-dot" aria-hidden="true">·</span>
        <span>{reading_time(@post.body)} min read</span>
      </div>

      <div :if={Posts.can_manage_post?(@current_scope, @post)} class="article-actions">
        <.link navigate={~p"/posts/#{@post}/edit"} class="text-link">
          <.icon name="hero-pencil-square" class="size-4" /> Edit story
        </.link>
        <.link
          href={~p"/posts/#{@post}"}
          method="delete"
          data-confirm="Delete this story?"
          class="text-link text-error"
        >
          <.icon name="hero-trash" class="size-4" /> Delete
        </.link>
      </div>
    </header>

    <div class="article-rule"></div>
    <div class="markdown-content">
      {markdown_to_html(@post.body)}
    </div>
  </article>

  <section id="comments" class="comments-section">
    <div class="section-heading">
      <h2>Discussion</h2>
      <span class="section-count">{length(@comments)} {if length(@comments) == 1,
        do: "comment",
        else: "comments"}</span>
    </div>

    <div :if={@comments != []} class="comment-list">
      <article :for={comment <- @comments} id={"comment-#{comment.id}"} class="comment-item">
        <div class="comment-header">
          <span class="comment-author">{Comment.author_name(comment)}</span>
          <time datetime={DateTime.to_iso8601(comment.inserted_at)} class="comment-date">
            {Calendar.strftime(comment.inserted_at, "%b %d, %Y")}
          </time>
          <.link
            :if={Posts.can_delete_comment?(@current_scope, comment, @post)}
            href={~p"/posts/#{@post}/comments/#{comment}"}
            method="delete"
            data-confirm="Delete this comment?"
            class="comment-delete"
          >
            Delete
          </.link>
        </div>
        <p class="comment-body">{comment.body}</p>
      </article>
    </div>

    <div class="comment-form-panel">
      <%= if @current_scope do %>
        <h3 class="form-panel-title">Leave a thought</h3>
        <.form for={@comment_form} id="comment-form" action={~p"/posts/#{@post}/comments"}>
          <.input field={@comment_form[:body]} type="textarea" label="Your comment" rows={4} />
          <div class="mt-4">
            <.button variant="primary">Post comment</.button>
          </div>
        </.form>
      <% else %>
        <h3 class="form-panel-title">Join the conversation</h3>
        <p class="form-panel-copy">
          <.link href={~p"/users/log-in"} class="text-link">Log in</.link>
          or <.link href={~p"/users/register"} class="text-link">create an account</.link>
          to leave a comment.
        </p>
      <% end %>
    </div>
  </section>
</Layouts.app>
