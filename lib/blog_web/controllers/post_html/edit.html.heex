<Layouts.app flash={@flash} current_scope={@current_scope}>
  <.header>
    Edit Post
    <:actions>
      <.button href={~p"/posts/#{@post}"}>
        <.icon name="hero-arrow-left" /> Back to post
      </.button>
    </:actions>
  </.header>

  <.post_form
    form={@form}
    action={~p"/posts/#{@post}"}
    return_to={~p"/posts/#{@post}"}
  />
</Layouts.app>
